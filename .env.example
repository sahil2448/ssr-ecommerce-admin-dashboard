# ============================================================
# ENV TEMPLATE - copy to ".env" locally OR paste the same
# key=value pairs into your Azure Container App:
#   Container app -> Containers -> Environment variables
# NEVER commit real secrets. Values here are placeholders.
# ============================================================

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DBNAME

# --- NextAuth ---
AUTH_SECRET=generate_one_with__openssl_rand_-base64_32
# Public URL of the running app (used by NextAuth + SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Runtime URL NextAuth uses for callbacks/redirects. In production set this
# to the deployed URL, e.g. https://ssr-admin-app.wittygrass-bd502b0a.centralindia.azurecontainerapps.io
NEXTAUTH_URL=http://localhost:3000

# --- AWS S3 (product image uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- Optional OAuth providers ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional AI description generator ---
OPENROUTER_API_KEY=
